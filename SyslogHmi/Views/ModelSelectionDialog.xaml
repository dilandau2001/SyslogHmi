<Window x:Class="SyslogHmi.Views.ModelSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SyslogHmi.Converters"
        xmlns:local="clr-namespace:SyslogHmi.ViewModels"
        Title="AI Model Manager"
        Height="700"
        Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F5F6FA"
        Loaded="Window_Loaded">

    <Window.Resources>
        <converters:ModelStateToBackgroundConverter x:Key="ModelStateToBackgroundConverter"/>
        <converters:ModelStateToDownloadButtonVisibilityConverter x:Key="ModelStateToDownloadButtonVisibilityConverter"/>
        <converters:ModelStateToLoadButtonVisibilityConverter x:Key="ModelStateToLoadButtonVisibilityConverter"/>
        <converters:ModelStateToUnloadButtonVisibilityConverter x:Key="ModelStateToUnloadButtonVisibilityConverter"/>
        <converters:ModelStateToDeleteButtonVisibilityConverter x:Key="ModelStateToDeleteButtonVisibilityConverter"/>
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
        <converters:InvertBoolConverter x:Key="InvertBoolConverter"/>
        <converters:IsAskingToButtonContentConverter x:Key="IsAskingToButtonContentConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with title and info -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20" Margin="0">
            <StackPanel>
                <TextBlock FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,5">
                    🤖 Select IA Model for SQL Generation
                </TextBlock>
                <TextBlock FontSize="12" Foreground="#BDC3C7" TextWrapping="Wrap">
                    Choose a model to download, load it, or use an already loaded one. Models are cached locally after first download.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- All Models List -->
        <ListBox Grid.Row="1" 
                 x:Name="ModelsList"
                 ItemsSource="{Binding AllModels}"
                 Background="White"
                 BorderThickness="1"
                 BorderBrush="#BDC3C7"
                 Margin="15,10,15,10">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="ToolTip" Value="{Binding FileSizeDisplay}"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12" 
                            BorderThickness="0,0,0,1" 
                            BorderBrush="#ECF0F1">
                        <Border.Background>
                            <MultiBinding Converter="{StaticResource ModelStateToBackgroundConverter}">
                                <Binding Path="."/>
                                <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}"/>
                            </MultiBinding>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Model info -->
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock FontWeight="Bold" FontSize="12" Foreground="#2C3E50">
                                        <Run Text="{Binding Name, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock FontSize="9" Foreground="#7F8C8D" TextWrapping="Wrap" Margin="0,0,0,3">
                                    <Run Text="{Binding Description, Mode=OneWay}"/>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <TextBlock FontSize="8" Foreground="#34495E" Margin="0,0,12,0">
                                        <Run Text="💾 "/>
                                        <Run Text="{Binding FileSizeDisplay, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="8" Foreground="#34495E" Margin="0,0,12,0">
                                        <Run Text="💻 "/>
                                        <Run Text="{Binding RecommendedRamGb, Mode=OneWay, StringFormat='{}{0}GB'}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="8" Foreground="#34495E" Margin="0,0,12,0">
                                        <Run Text="⚡ "/>
                                        <Run Text="{Binding InferenceSpeed, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <!-- Action buttons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button x:Name="DownloadButton" 
                                        Content="📥 Download" 
                                        Padding="10,6"
                                        Background="#3498DB"
                                        Foreground="White"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Margin="0,0,6,0"
                                        Click="DownloadButton_Click">
                                    <Button.Visibility>
                                        <MultiBinding Converter="{StaticResource ModelStateToDownloadButtonVisibilityConverter}">
                                            <Binding Path="."/>
                                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        </MultiBinding>
                                    </Button.Visibility>
                                </Button>
                                <Grid x:Name="LoadButtonGrid"
                                      Margin="0,0,6,0"
                                      Width="70"
                                      Height="28">
                                    <Grid.Visibility>
                                        <MultiBinding Converter="{StaticResource ModelStateToLoadButtonVisibilityConverter}">
                                            <Binding Path="."/>
                                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        </MultiBinding>
                                    </Grid.Visibility>
                                    <Button x:Name="LoadButton" 
                                            Content="▶ Load" 
                                            Padding="10,6"
                                            Background="#5DADE2"
                                            Foreground="White"
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Click="LoadButton_Click">
                                        <Button.Visibility>
                                            <Binding Path="DataContext.IsLoadingModel" RelativeSource="{RelativeSource AncestorType=Window}" Converter="{StaticResource InvertBoolConverter}"/>
                                        </Button.Visibility>
                                    </Button>
                                    <Border Background="#5DADE2" 
                                            CornerRadius="4">
                                        <Border.Visibility>
                                            <Binding Path="DataContext.IsLoadingModel" RelativeSource="{RelativeSource AncestorType=Window}" Converter="{StaticResource BoolToVisibilityConverter}"/>
                                        </Border.Visibility>
                                        <TextBlock x:Name="LoadingIndicator" 
                                                   Text="⟳"
                                                   Foreground="White"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Opacity="0.8">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform x:Name="RotateTransform" CenterX="6" CenterY="6"/>
                                            </TextBlock.RenderTransform>
                                            <TextBlock.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation
                                                                Storyboard.TargetName="RotateTransform"
                                                                Storyboard.TargetProperty="Angle"
                                                                From="0"
                                                                To="360"
                                                                Duration="0:0:1"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </TextBlock.Triggers>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                                <Button x:Name="UnloadButton" 
                                        Content="⏹ Unload" 
                                        Padding="10,6"
                                        Background="#E74C3C"
                                        Foreground="White"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Margin="0,0,6,0"
                                        Click="UnloadButton_Click">
                                    <Button.Visibility>
                                        <MultiBinding Converter="{StaticResource ModelStateToUnloadButtonVisibilityConverter}">
                                            <Binding Path="."/>
                                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        </MultiBinding>
                                    </Button.Visibility>
                                </Button>
                                <Button x:Name="DeleteButton"
                                        Content="🗑 Delete"
                                        Padding="10,6"
                                        Background="#C0392B"
                                        Foreground="White"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Click="DeleteButton_Click">
                                    <Button.Visibility>
                                        <MultiBinding Converter="{StaticResource ModelStateToDeleteButtonVisibilityConverter}">
                                            <Binding Path="."/>
                                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        </MultiBinding>
                                    </Button.Visibility>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Prompt area for natural language question -->
        <Border Grid.Row="2" Margin="15,0,15,10" Opacity="{Binding CanAsk, Converter={StaticResource BoolToOpacityConverter}}" IsEnabled="{Binding CanAsk}">
            <StackPanel>
                <TextBlock FontSize="11" FontWeight="Bold" Foreground="#2D3436" Margin="0,0,0,4">Ask (natural language):</TextBlock>
                <TextBox Text="{Binding PromptText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         Height="60" AcceptsReturn="True" TextWrapping="Wrap" Padding="8" Background="#FBFCFD" BorderBrush="#E0E0E0" FontSize="10"/>
            </StackPanel>
        </Border>

        <!-- Progress Section (visible during download) -->
        <Border Grid.Row="3"
                Margin="15,0,15,10"
                Background="White"
                BorderThickness="1"
                BorderBrush="#3498DB"
                Padding="12"
                CornerRadius="4"
                Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}"
                VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontWeight="Bold" Foreground="#2980B9" FontSize="12">
                    📥 Downloading Model...
                </TextBlock>

                <TextBlock Grid.Row="1" FontWeight="Bold" Foreground="#2C3E50" Margin="0,8,0,0">
                    <Run Text="{Binding CurrentDownloadName, Mode=OneWay}"/>
                </TextBlock>

                <ProgressBar Grid.Row="2"
                            Height="24"
                            Margin="0,10,0,0"
                            Value="{Binding DownloadProgressPercent, Mode=OneWay}"
                            Foreground="#3498DB"
                            Background="#ECF0F1"/>

                <TextBlock Grid.Row="2"
                          FontSize="10"
                          Foreground="White"
                          FontWeight="Bold"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                    <Run Text="{Binding DownloadProgressPercent, Mode=OneWay, StringFormat='{}{0:F0}%'}"/>
                </TextBlock>

                <TextBlock Grid.Row="3"
                          FontSize="10"
                          Foreground="#7F8C8D"
                          Margin="0,6,0,0">
                    <Run Text="{Binding DownloadedMb, Mode=OneWay, StringFormat='{}{0:F1} MB'}"/>
                    <Run Text=" / "/>
                    <Run Text="{Binding TotalMb, Mode=OneWay, StringFormat='{}{0:F1} MB'}"/>
                    <Run Text=" • "/>
                    <Run Text="{Binding DownloadSpeed, Mode=OneWay}"/>
                    <Run Text=" • "/>
                    <Run Text="ETA: "/>
                    <Run Text="{Binding TimeRemaining, Mode=OneWay}"/>
                </TextBlock>

                <Button Grid.Row="4"
                       Content="Cancel Download"
                       Click="CancelDownload_Click"
                       Padding="12,6"
                       Margin="0,10,0,0"
                       Background="#E74C3C"
                       Foreground="White"
                       FontWeight="Bold"
                       HorizontalAlignment="Left"
                       Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <!-- Bottom buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="15,10,15,10" Height="40">
            <Button Content="Close" 
                   Click="CloseButton_Click"
                   Padding="20,12"
                   MinWidth="100"
                   Background="#95A5A6"
                   Foreground="White"
                   FontWeight="Bold"
                   Margin="0,0,10,0"/>

            <Button x:Name="AskButton"
                    Content="{Binding IsAsking, Converter={StaticResource IsAskingToButtonContentConverter}}"
                    Click="AskIa_Click"
                    Padding="20,12"
                    MinWidth="120"
                    Background="#95ad16"
                    Foreground="White"
                    FontWeight="Bold"
                    IsEnabled="{Binding CanAsk}"
                    Opacity="{Binding CanAsk, Converter={StaticResource BoolToOpacityConverter}}"/>
        </StackPanel>
    </Grid>
</Window>
